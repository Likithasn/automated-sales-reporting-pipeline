{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "factoryName": {
            "type": "string",
            "metadata": "Data Factory name",
            "defaultValue": "adf-sales-pipeline247"
        },
        "LS_SalesBlobStorage_connectionString": {
            "type": "secureString",
            "metadata": "Secure string for 'connectionString' of 'LS_SalesBlobStorage'"
        },
        "LS_SalesSQLDB_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'LS_SalesSQLDB'"
        },
        "LS_SalesSQLDB_properties_typeProperties_server": {
            "type": "string",
            "defaultValue": "sqlsrv-sales247.database.windows.net"
        },
        "LS_SalesSQLDB_properties_typeProperties_database": {
            "type": "string",
            "defaultValue": "SalesDB"
        },
        "LS_SalesSQLDB_properties_typeProperties_userName": {
            "type": "string",
            "defaultValue": "sqladmin"
        },
        "TR_DailySalesLoad_properties_PL_LoadSales_parameters_folderName": {
            "type": "string",
            "defaultValue": "raw"
        },
        "TR_DailySalesLoad_properties_PL_LoadSales_parameters_fileName": {
            "type": "string",
            "defaultValue": "Sales_2026_09_04.csv"
        },
        "containerUri": {
            "type": "string",
            "metadata": "URI to storage account containing linked ARM templates"
        },
        "containerSasToken": {
            "type": "string",
            "metadata": "Sas token to storage account containing linked ARM templates"
        }
    },
    "variables": {
        "factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
    },
    "resources": [
        {
            "name": "adf-sales-pipeline247_ArmTemplate_0",
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2024-03-01",
            "properties": {
                "mode": "incremental",
                "templateLink": {
                    "uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "factoryName": {
                        "value": "[parameters('factoryName')]"
                    },
                    "LS_SalesBlobStorage_connectionString": {
                        "value": "[parameters('LS_SalesBlobStorage_connectionString')]"
                    },
                    "LS_SalesSQLDB_password": {
                        "value": "[parameters('LS_SalesSQLDB_password')]"
                    },
                    "LS_SalesSQLDB_properties_typeProperties_server": {
                        "value": "[parameters('LS_SalesSQLDB_properties_typeProperties_server')]"
                    },
                    "LS_SalesSQLDB_properties_typeProperties_database": {
                        "value": "[parameters('LS_SalesSQLDB_properties_typeProperties_database')]"
                    },
                    "LS_SalesSQLDB_properties_typeProperties_userName": {
                        "value": "[parameters('LS_SalesSQLDB_properties_typeProperties_userName')]"
                    },
                    "TR_DailySalesLoad_properties_PL_LoadSales_parameters_folderName": {
                        "value": "[parameters('TR_DailySalesLoad_properties_PL_LoadSales_parameters_folderName')]"
                    },
                    "TR_DailySalesLoad_properties_PL_LoadSales_parameters_fileName": {
                        "value": "[parameters('TR_DailySalesLoad_properties_PL_LoadSales_parameters_fileName')]"
                    }
                }
            },
            "dependsOn": []
        }
    ]
}